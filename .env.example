# Copy to .env locally. Never commit .env or fill real values in this template.
# Required for the bot and authenticated Mini App; create YOUR OWN bot with BotFather.
TELEGRAM_BOT_TOKEN=replace-with-your-own-bot-token
# Positive numeric Telegram ID of YOUR deployment owner; 0 intentionally prevents bot startup.
TELEGRAM_OWNER_ID=0

# Preferred conversational provider: YOUR OWN Toronto IBM Cloud Orchestrate instance.
WXO_API_URL=https://api.ca-tor.watson-orchestrate.cloud.ibm.com/instances/replace-with-your-instance
WXO_API_KEY=replace-with-your-own-orchestrate-api-key
WXO_AGENT_ID=replace-with-your-deployed-agent-uuid

# Legacy optional watsonx.ai Runtime provider; separate credentials and quota.
IBM_CLOUD_API_KEY=replace-with-your-own-ibm-key
WATSONX_PROJECT_ID=replace-with-your-own-project-id
WATSONX_URL=https://jp-tok.ml.cloud.ibm.com
# Optional override of config/conversation.json model_id.
WATSONX_CONVERSATION_MODEL=meta-llama/llama-3-3-70b-instruct

# Optional Brightspace: YOUR institution origin, not a copied school session.
# Replace example.edu before enabling any MCP operation. No password/cookie/token is required here.
D2L_BASE_URL=https://brightspace.example.edu
# Own browser session; wrapper defaults to .private-lms/session inside this clone.
# D2L_SESSION_DIR=C:/path/to/this-clone/.private-lms/session
D2L_HEADLESS=false
# Disable upstream automatic update/re-execution; read-only server version is pinned in code.
D2L_NO_UPDATE_CHECK=1
